# Copy to .env and fill in.
# Free key, no credit card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# gemini  - real tool-calling model (needed to actually answer questions)
# scripted - stub used by the test suite; returns prepared responses
AGENT_LLM_BACKEND=gemini
AGENT_GEMINI_MODEL=gemini-3.1-flash-lite

# Agent loop
AGENT_MAX_STEPS=10
AGENT_MAX_SQL_RETRIES=3

# Warehouse
AGENT_MAX_ROWS=1000
AGENT_QUERY_TIMEOUT_SECONDS=20
AGENT_MAX_ROWS_TO_MODEL=30
