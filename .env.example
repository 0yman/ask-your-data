# Copy to .env and fill in.
# Free key, no credit card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# gemini   - real tool-calling model (needed to actually answer questions)
# openai   - any OpenAI-format chat-completions endpoint
# scripted - stub used by the test suite; returns prepared responses
AGENT_LLM_BACKEND=gemini
AGENT_GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI-format provider. Leave the base URL blank for OpenAI itself, or point
# it at Groq / Together / OpenRouter / a local Ollama or vLLM - the wire format
# is identical, so the adapter does not change.
OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_MODEL=gpt-4o-mini

# Agent loop
AGENT_MAX_STEPS=10
AGENT_MAX_SQL_RETRIES=3

# Warehouse
AGENT_MAX_ROWS=1000
AGENT_QUERY_TIMEOUT_SECONDS=20
AGENT_MAX_ROWS_TO_MODEL=30
